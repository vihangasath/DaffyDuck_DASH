# Copy to .env (optional). Every value has a default.

# Postgres password for `docker compose up` (the db and api services share it).
POSTGRES_PASSWORD=change-me

# Host ports.
WEB_PORT=3000
ADMIN_PORT=3001
API_PORT=4000

# How long a sign-in lasts, in hours.
SESSION_HOURS=12

# Local development (npm run dev) needs none of these: the API runs an embedded Postgres in ./.data.
# To use a Postgres server instead, set DATABASE_URL for the API, e.g.
# DATABASE_URL=postgres://waypoint:change-me@localhost:5432/waypoint
