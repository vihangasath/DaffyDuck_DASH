{
  "name": "@waypoint/api",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "description": "Waypoint API: owns the Postgres database (embedded PGlite in dev), auth, business rules and the admin endpoints.",
  "scripts": {
    "dev": "tsx watch --clear-screen=false src/index.ts",
    "start": "tsx src/index.ts",
    "test": "vitest run",
    "typecheck": "tsc --noEmit",
    "db:generate": "drizzle-kit generate",
    "db:reset": "tsx src/db/reset.ts"
  },
  "dependencies": {
    "@electric-sql/pglite": "^0.5.8",
    "@hono/node-server": "^2.1.1",
    "@waypoint/core": "*",
    "drizzle-orm": "^0.45.3",
    "hono": "^4.13.9",
    "pg": "^8.23.0",
    "tsx": "^4.23.15",
    "zod": "^4.6.5"
  },
  "devDependencies": {
    "@types/node": "^24.13.6",
    "@types/pg": "^8.23.1",
    "drizzle-kit": "^0.31.11",
    "typescript": "^5",
    "vitest": "^5.0.1"
  }
}
